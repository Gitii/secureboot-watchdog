#!/usr/bin/make -f

# Ubuntu 24.04's default cargo (1.75) cannot build edition-2024 crates such
# as clap_lex 1.1, so Build-Depends fall back to the versioned toolchain there,
# which is installed outside PATH.
ifneq ("$(wildcard /usr/lib/rust-1.91/bin/cargo)","")
    export PATH := /usr/lib/rust-1.91/bin:$(PATH)
endif

# Standard dh sequence, plus a cargo build for the UI binary.
%:
	dh $@

# Build the Rust UI binary. build.rs handles blueprint-compiler and
# glib-compile-resources for the embedded gresource bundle.
override_dh_auto_build:
	cd ui && cargo build --release --locked

# Files are placed by debian/install; the Makefile's install target builds
# and installs the .deb itself.
override_dh_auto_install:

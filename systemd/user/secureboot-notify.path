[Unit]
Description=Watch /run/secureboot-monitor/status.json for changes
Documentation=https://github.com/Gitii/secureboot-watchdog
# Notifications need the desktop session; outside it (TTY, SSH) a change
# would be recorded as seen without being shown.
PartOf=graphical-session.target

# PathChanged only: PathExists would re-run the notifier every time it exits,
# until systemd's trigger limit stops this unit. The status already present
# at login is picked up by secureboot-notify.service itself.
[Path]
PathChanged=/run/secureboot-monitor/status.json
Unit=secureboot-notify.service

[Install]
WantedBy=graphical-session.target
